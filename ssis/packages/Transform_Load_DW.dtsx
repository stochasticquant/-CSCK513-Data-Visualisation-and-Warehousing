                          name="Expression">[ISNULL](#{Package\DFT fact_sales\SRC order lines + orders + latest status.Outputs[OLE DB Source Output].Columns[order_date]}) ? -1 : (DT_I4)([YEAR](#{Package\DFT fact_sales\SRC order lines + orders + latest status.Outputs[OLE DB Source Output].Columns[order_date]}) * 10000 + [MONTH](#{Package\DFT fact_sales\SRC order lines + orders + latest status.Outputs[OLE DB Source Output].Columns[order_date]}) * 100 + [DAY](#{Package\DFT fact_sales\SRC order lines + orders + latest status.Outputs[OLE DB Source Output].Columns[order_date]}))</property>
