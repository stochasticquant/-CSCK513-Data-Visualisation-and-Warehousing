              description="OLE DB Source"
              name="SRC order lines + orders + latest status"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT ol.line_id, ol.order_id, ol.book_id, o.customer_id, o.dest_address_id, o.shipping_method_id, o.order_date,
       CAST(ol.price AS DECIMAL(7,2)) AS sales_amount,
       CAST(COALESCE(st.status_value, 'Unknown') AS VARCHAR(20)) AS latest_order_status,
       CAST(CASE WHEN EXISTS (SELECT 1 FROM stg.order_history h
                              WHERE h.order_id = ol.order_id AND h.status_id IN (5, 6))  -- Cancelled / Returned
                 THEN 1 ELSE 0 END AS BIT) AS is_cancelled_or_returned
FROM stg.order_line ol
LEFT JOIN stg.cust_order o ON o.order_id = ol.order_id
OUTER APPLY (SELECT TOP (1) h.status_id FROM stg.order_history h
             WHERE h.order_id = ol.order_id ORDER BY h.status_date DESC, h.history_id DESC) lh
LEFT JOIN stg.order_status st ON st.status_id = lh.status_id</property>
