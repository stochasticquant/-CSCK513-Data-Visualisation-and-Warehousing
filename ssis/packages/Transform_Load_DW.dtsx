                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT b.book_id, CAST(b.title AS VARCHAR(400)) AS title, b.isbn13, b.num_pages, b.publication_date,
       CAST(p.publisher_name AS VARCHAR(400)) AS publisher_name, l.language_code, l.language_name
FROM stg.book b
LEFT JOIN stg.publisher p     ON p.publisher_id = b.publisher_id
LEFT JOIN stg.book_language l ON l.language_id  = b.language_id</property>
