        <SQLTask:SqlTaskData
          SQLTask:Connection="{52E5EF54-7E1E-4247-B539-B80CDF943CA0}"
          SQLTask:SqlStatementSource="EXEC etl.usp_prepare_full_load;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL Reconcile row counts"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Compares staging and warehouse row counts, logs them to etl.audit and fails the package on a mismatch"
      DTS:DTSID="{B9870A58-59F1-48B4-AC4E-9BF35523D6E7}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL Reconcile row counts"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{52E5EF54-7E1E-4247-B539-B80CDF943CA0}"
          SQLTask:SqlStatementSource="DECLARE @run DATETIME2 = SYSDATETIME();&#xA;INSERT INTO etl.audit (package_name, task_name, table_name, rows_read, rows_written, rows_rejected, start_time, end_time, status)&#xA;SELECT 'Transform_Load_DW', 'Reconcile', table_name, rows_read, rows_written, rows_rejected, @run, SYSDATETIME(),&#xA;       CASE WHEN rows_read = rows_written + rows_rejected THEN 'Success' ELSE 'Mismatch' END&#xA;FROM (VALUES&#xA;  ('dbo.dim_book',            (SELECT COUNT(*) FROM gravity_staging.stg.book),            (SELECT COUNT(*) FROM dbo.dim_book WHERE book_key &lt;&gt; -1), 0),&#xA;  ('dbo.dim_customer',        (SELECT COUNT(*) FROM gravity_staging.stg.customer),        (SELECT COUNT(*) FROM dbo.dim_customer WHERE customer_key &lt;&gt; -1), 0),&#xA;  ('dbo.dim_location',        (SELECT COUNT(*) FROM gravity_staging.stg.address),         (SELECT COUNT(*) FROM dbo.dim_location WHERE location_key &lt;&gt; -1), 0),&#xA;  ('dbo.dim_shipping_method', (SELECT COUNT(*) FROM gravity_staging.stg.shipping_method), (SELECT COUNT(*) FROM dbo.dim_shipping_method WHERE shipping_key &lt;&gt; -1), 0),&#xA;  ('dbo.dim_date', (SELECT DATEDIFF(DAY, MIN(CASE WHEN config_key = 'dim_date_start' THEN CAST(config_value AS DATE) END),&#xA;                                     MAX(CASE WHEN config_key = 'dim_date_end' THEN CAST(config_value AS DATE) END)) + 1 FROM etl.config),&#xA;                   (SELECT COUNT(*) FROM dbo.dim_date WHERE date_key &lt;&gt; -1), 0),&#xA;  ('dbo.fact_sales', (SELECT COUNT(*) FROM gravity_staging.stg.order_line), (SELECT COUNT(*) FROM dbo.fact_sales), (SELECT COUNT(*) FROM dq.fact_rejects))&#xA;) v (table_name, rows_read, rows_written, rows_rejected);&#xA;&#xA;IF EXISTS (SELECT 1 FROM etl.audit WHERE package_name = 'Transform_Load_DW' AND start_time = @run AND status = 'Mismatch')&#xA;    THROW 50001, 'Row count reconciliation failed: see etl.audit', 1;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL Run data-quality checks"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Runs the data-quality checks on the staged data and logs the results to dq.check_log"
      DTS:DTSID="{19436A29-B632-46CA-931B-90ECBB546E03}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL Run data-quality checks"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{52E5EF54-7E1E-4247-B539-B80CDF943CA0}"
          SQLTask:SqlStatementSource="EXEC dq.usp_run_checks;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
