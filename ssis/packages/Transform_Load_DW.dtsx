    <DTS:Executable
      DTS:refId="Package\SQL Prepare full load"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Empties the fact and dimension tables (keeps the -1 unknown members) for a full reload"
      DTS:DTSID="{5A400A2D-55A7-4098-BF5F-685584596EDA}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
