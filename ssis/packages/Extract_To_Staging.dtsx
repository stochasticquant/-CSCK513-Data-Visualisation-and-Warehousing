    <DTS:Executable
      DTS:refId="Package\SQL Log row counts"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Writes the row count of every staging table to gravity_dw.etl.audit"
      DTS:DTSID="{2BF38CA6-5EFA-4F3B-9298-C2DE9C691819}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL Log row counts"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{D80F5EA7-323D-4A8E-8A11-C24CC273527E}"
          SQLTask:SqlStatementSource="INSERT INTO etl.audit (package_name, task_name, table_name, rows_written, end_time, status)&#xA;SELECT 'Extract_To_Staging', 'Extract', table_name, row_count, SYSDATETIME(), 'Success'&#xA;FROM (&#xA;      SELECT 'stg.book' AS table_name, COUNT(*) AS row_count FROM gravity_staging.stg.book&#xA;UNION ALL SELECT 'stg.book_language' AS table_name, COUNT(*) AS row_count FROM gravity_staging.stg.book_language&#xA;UNION ALL SELECT 'stg.publisher' AS table_name, COUNT(*) AS row_count FROM gravity_staging.stg.publisher&#xA;UNION ALL SELECT 'stg.customer' AS table_name, COUNT(*) AS row_count FROM gravity_staging.stg.customer&#xA;UNION ALL SELECT 'stg.address' AS table_name, COUNT(*) AS row_count FROM gravity_staging.stg.address&#xA;UNION ALL SELECT 'stg.country' AS table_name, COUNT(*) AS row_count FROM gravity_staging.stg.country&#xA;UNION ALL SELECT 'stg.cust_order' AS table_name, COUNT(*) AS row_count FROM gravity_staging.stg.cust_order&#xA;UNION ALL SELECT 'stg.order_line' AS table_name, COUNT(*) AS row_count FROM gravity_staging.stg.order_line&#xA;UNION ALL SELECT 'stg.order_history' AS table_name, COUNT(*) AS row_count FROM gravity_staging.stg.order_history&#xA;UNION ALL SELECT 'stg.order_status' AS table_name, COUNT(*) AS row_count FROM gravity_staging.stg.order_status&#xA;UNION ALL SELECT 'stg.shipping_method' AS table_name, COUNT(*) AS row_count FROM gravity_staging.stg.shipping_method&#xA;UNION ALL SELECT 'stg.survey' AS table_name, COUNT(*) AS row_count FROM gravity_staging.stg.survey&#xA;UNION ALL SELECT 'stg.country_region' AS table_name, COUNT(*) AS row_count FROM gravity_staging.stg.country_region&#xA;) counts;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL Truncate staging tables"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Empties every staging table so the package can be re-run without duplicating rows"
      DTS:DTSID="{D0179109-F623-45E6-B689-01AE6592022B}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL Truncate staging tables"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{D9C5F8E2-65B4-4E80-B4B6-B20D3F726AF5}"
          SQLTask:SqlStatementSource="TRUNCATE TABLE stg.book;&#xA;TRUNCATE TABLE stg.book_language;&#xA;TRUNCATE TABLE stg.publisher;&#xA;TRUNCATE TABLE stg.customer;&#xA;TRUNCATE TABLE stg.address;&#xA;TRUNCATE TABLE stg.country;&#xA;TRUNCATE TABLE stg.cust_order;&#xA;TRUNCATE TABLE stg.order_line;&#xA;TRUNCATE TABLE stg.order_history;&#xA;TRUNCATE TABLE stg.order_status;&#xA;TRUNCATE TABLE stg.shipping_method;&#xA;TRUNCATE TABLE stg.survey;&#xA;TRUNCATE TABLE stg.country_region;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
